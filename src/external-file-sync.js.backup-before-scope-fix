function discoverRenamedWorkingFile( 

    mapping 

) { 

 

    const directory = 

        path.dirname( 

            mapping.oneDrivePath 

        ); 

 

 

    if ( 

        !fs.existsSync( 

            directory 

        ) 

    ) { 

 

        return null; 

    } 

 

 

    let entries; 

 

 

    try { 

 

        entries = 

            fs.readdirSync( 

                directory, 

                { 

                    withFileTypes: true 

                } 

            ); 

 

 

    } catch (_) { 

 

        return null; 

    } 

 

 

    const candidates = 

        entries 

            .filter( 

                entry => 

                    entry.isFile() 

            ) 

            .map( 

                entry => 

                    path.join( 

                        directory, 

                        entry.name 

                    ) 

            ) 

            .filter( 

                candidate => { 

 

                    const name = 

                        path.basename( 

                            candidate 

                        ); 

 

 

                    if ( 

                        SAFE_BACKUP_PATTERN.test( 

                            name 

                        ) 

                    ) { 

 

                        return false; 

                    } 

 

 

                    if ( 

                        name.endsWith( 

                            ".partial" 

                        ) 

                    ) { 

 

                        return false; 

                    } 

 

 

                    if ( 

                        name.endsWith( 

                            ".tmp" 

                        ) 

                    ) { 

 

                        return false; 

                    } 

 

 

                    return true; 

                } 

            ); 

 

 

    if ( 

        candidates.length !== 1 

    ) { 

 

        return null; 

    } 

 

 

    return candidates[0]; 

} 

 

 

function updateRenamedWorkingFile( 

    mapping 

) { 

 

    if ( 

        fs.existsSync( 

            mapping.oneDrivePath 

        ) 

    ) { 

 

        return false; 

    } 

 

 

    const replacement = 

        discoverRenamedWorkingFile( 

            mapping 

        ); 

 

 

    if ( 

        !replacement 

    ) { 

 

        return false; 

    } 

 

 

    console.log( 

        "[External Sync] OneDrive rename detected:" 

    ); 

 

 

    console.log( 

        "  Old:", 

        mapping.oneDrivePath 

    ); 

 

 

    console.log( 

        "  New:", 

        replacement 

    ); 

 

 

    mapping.oneDrivePath = 

        replacement; 

 

 

    mapping.fileName = 

        path.basename( 

            replacement 

        ); 

 

 

    mapping.updatedAt = 

        new Date() 

            .toISOString(); 

 

 

    return true; 

} 

 

 

function registerExternalFile( 

    originalPath, 

    oneDrivePath, 

    copied 

) { 

 

    const absoluteOriginal = 

        path.resolve( 

            originalPath 

        ); 

 

 

    const absoluteOneDrive = 

        path.resolve( 

            oneDrivePath 

        ); 

 

 

    const id = 

        mappingId( 

            absoluteOriginal 

        ); 

 

 

    const registry = 

        readRegistry(); 

 

 

    const previous = 

        registry.mappings[ 

            id 

        ] || null; 

 

 

    const oneDriveHash = 

        safeHashFile( 

            absoluteOneDrive 

        ); 

 

 

    const originalHash = 

        safeHashFile( 

            absoluteOriginal 

        ); 

 

 

    const baselineOneDriveHash = 

        ( 

            !previous || 

            copied 

        ) 

            ? oneDriveHash 

            : previous.lastCopiedHash; 

 

 

    const baselineOriginalHash = 

        ( 

            !previous || 

            copied 

        ) 

            ? originalHash 

            : ( 

                previous.originalBaselineHash || 

                originalHash 

            ); 

 

 

    registry.mappings[ 

        id 

    ] = { 

 

        id, 

 

        originalPath: 

            absoluteOriginal, 

 

        oneDrivePath: 

            absoluteOneDrive, 

 

        fileName: 

            path.basename( 

                absoluteOneDrive 

            ), 

 

        registeredAt: 

            previous?.registeredAt || 

            new Date() 

                .toISOString(), 

 

        updatedAt: 

            new Date() 

                .toISOString(), 

 

        lastCopiedHash: 

            baselineOneDriveHash, 

 

        originalBaselineHash: 

            baselineOriginalHash, 

 

        lastCopiedBackAt: 

            previous?.lastCopiedBackAt || 

            null, 

 

        lastConflictAt: 

            previous?.lastConflictAt || 

            null, 

 

        lastConflictPath: 

            previous?.lastConflictPath || 

            null, 

 

        conflict: 

            false, 

 

        lastError: 

            null 

    }; 

 

 

    writeRegistry( 

        registry 

    ); 

 

 

    console.log( 

        "[External Sync] Registered:", 

        absoluteOneDrive, 

        "->", 

        absoluteOriginal 

    ); 

 

 

    return registry.mappings[ 

        id 

    ]; 

} 

 

 

function getExternalMapping( 

    originalPath 

) { 

 

    const registry = 

        readRegistry(); 

 

 

    const id = 

        mappingId( 

            path.resolve( 

                originalPath 

            ) 

        ); 

 

 

    const mapping = 

        registry.mappings[ 

            id 

        ] || null; 

 

 

    if ( 

        !mapping 

    ) { 

 

        return null; 

    } 

 

 

    if ( 

        updateRenamedWorkingFile( 

            mapping 

        ) 

    ) { 

 

        registry.mappings[ 

            id 

        ] = 

            mapping; 

 

 

        writeRegistry( 

            registry 

        ); 

    } 

 

 

    return mapping; 

} 

 

 

function cleanupStaleMappings( 

    registry 

) { 

 

    let changed = 

        false; 

 

 

    for ( 

        const [ 

            id, 

            mapping 

        ] 

        of Object.entries( 

            registry.mappings 

        ) 

    ) { 

 

        if ( 

            mapping.originalPath && 

            mapping.originalPath.startsWith( 

                "/run/user/" 

            ) && 

            !fs.existsSync( 

                mapping.originalPath 

            ) 

        ) { 

 

            console.log( 

                "[External Sync] Removing stale portal mapping:", 

                mapping.originalPath 

            ); 

 

 

            delete registry.mappings[ 

                id 

            ]; 

 

 

            changed = 

                true; 

        } 

    } 

 

 

    return changed; 

} 

 

 

