function ensureRegistryDirectory() { 

 

    fs.mkdirSync( 

        registryDirectory, 

        { 

            recursive: true, 

            mode: 0o700 

        } 

    ); 

} 

 

 

function emptyRegistry() { 

 

    return { 

        version: 4, 

        mappings: {} 

    }; 

} 

 

 

function readRegistry() { 

 

    ensureRegistryDirectory(); 

 

 

    try { 

 

        if ( 

            !fs.existsSync( 

                registryFile 

            ) 

        ) { 

 

            return emptyRegistry(); 

        } 

 

 

        const data = 

            JSON.parse( 

                fs.readFileSync( 

                    registryFile, 

                    "utf8" 

                ) 

            ); 

 

 

        if ( 

            !data || 

            typeof data !== "object" || 

            !data.mappings 

        ) { 

 

            return emptyRegistry(); 

        } 

 

 

        data.version = 

            4; 

 

 

        return data; 

 

 

    } catch ( 

        error 

    ) { 

 

        console.error( 

            "[External Sync] Unable to read registry:", 

            error 

        ); 

 

 

        return emptyRegistry(); 

    } 

} 

 

 

function writeRegistry( 

    registry 

) { 

 

    ensureRegistryDirectory(); 

 

 

    const temporary = 

        registryFile + 

        ".tmp"; 

 

 

    fs.writeFileSync( 

        temporary, 

        JSON.stringify( 

            registry, 

            null, 

            2 

        ), 

        { 

            encoding: "utf8", 

            mode: 0o600 

        } 

    ); 

 

 

    fs.renameSync( 

        temporary, 

        registryFile 

    ); 

} 

 

 

function hashFile( 

    filePath 

) { 

 

    const hash = 

        crypto.createHash( 

            "sha256" 

        ); 

 

 

    const fd = 

        fs.openSync( 

            filePath, 

            "r" 

        ); 

 

 

    const buffer = 

        Buffer.alloc( 

            1024 * 1024 

        ); 

 

 

    try { 

 

        let bytesRead = 

            0; 

 

 

        do { 

 

            bytesRead = 

                fs.readSync( 

                    fd, 

                    buffer, 

                    0, 

                    buffer.length, 

                    null 

                ); 

 

 

            if ( 

                bytesRead > 0 

            ) { 

 

                hash.update( 

                    buffer.subarray( 

                        0, 

                        bytesRead 

                    ) 

                ); 

            } 

 

 

        } while ( 

            bytesRead > 0 

        ); 

 

 

    } finally { 

 

        fs.closeSync( 

            fd 

        ); 

    } 

 

 

    return hash.digest( 

        "hex" 

    ); 

} 

 

 

function safeHashFile( 

    filePath 

) { 

 

    try { 

 

        if ( 

            !fs.existsSync( 

                filePath 

            ) 

        ) { 

 

            return null; 

        } 

 

 

        return hashFile( 

            filePath 

        ); 

 

 

    } catch (_) { 

 

        return null; 

    } 

} 

 

 

function mappingId( 

    originalPath 

) { 

 

    return crypto 

        .createHash( 

            "sha256" 

        ) 

        .update( 

            path.resolve( 

                originalPath 

            ) 

        ) 

        .digest( 

            "hex" 

        ) 

        .slice( 

            0, 

            24 

        ); 

} 

 

 

