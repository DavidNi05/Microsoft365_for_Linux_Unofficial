/* 

 * Build a collision-safe filename when a cloud rename 

 * would overwrite an unrelated local file. 

 */ 

function buildManualCollisionPath( 

    desiredPath 

) { 

 

    const directory = 

        path.dirname( 

            desiredPath 

        ); 

 

 

    const extension = 

        path.extname( 

            desiredPath 

        ); 

 

 

    const baseName = 

        path.basename( 

            desiredPath, 

            extension 

        ); 

 

 

    const timestamp = 

        new Date() 

            .toISOString() 

            .replace( 

                /[:.]/g, 

                "-" 

            ); 

 

 

    return path.join( 

        directory, 

        `${baseName} (M365 saved copy ${timestamp})${extension}` 

    ); 

} 

 

 

/* 

 * Atomically replace a local file with the current 

 * managed OneDrive copy. 

 * 

 * A temporary file is created in the same directory 

 * so the final rename stays on the same filesystem. 

 */ 

function atomicCopyToLocal( 

    sourcePath, 

    destinationPath 

) { 

 

    const directory = 

        path.dirname( 

            destinationPath 

        ); 

 

 

    const temporaryPath = 

        path.join( 

            directory, 

            `.${path.basename(destinationPath)}.m365-${process.pid}-${Date.now()}.tmp` 

        ); 

 

 

    let originalMode = 

        null; 

 

 

    try { 

 

        if ( 

            fs.existsSync( 

                destinationPath 

            ) 

        ) { 

 

            originalMode = 

                fs.statSync( 

                    destinationPath 

                ).mode; 

        } 

 

 

        fs.copyFileSync( 

            sourcePath, 

            temporaryPath 

        ); 

 

 

        if ( 

            originalMode !== null 

        ) { 

 

            try { 

 

                fs.chmodSync( 

                    temporaryPath, 

                    originalMode 

                ); 

 

            } catch (_) {} 

        } 

 

 

        fs.renameSync( 

            temporaryPath, 

            destinationPath 

        ); 

 

 

    } catch ( 

        error 

    ) { 

 

        try { 

 

            fs.rmSync( 

                temporaryPath, 

                { 

                    force: true 

                } 

            ); 

 

        } catch (_) {} 

 

 

        throw error; 

    } 

} 

 

 

/* 

 * Move the mapping to a new registry key when the 

 * original local file itself has been renamed. 

 * 

 * mappingId() is based on originalPath, therefore 

 * the registry key must also change. 

 */ 

function rekeyMapping( 

    registry, 

    oldId, 

    mapping, 

    newOriginalPath 

) { 

 

    const absoluteNewPath = 

        path.resolve( 

            newOriginalPath 

        ); 

 

 

    const newId = 

        mappingId( 

            absoluteNewPath 

        ); 

 

 

    delete registry.mappings[ 

        oldId 

    ]; 

 

 

    mapping.id = 

        newId; 

 

 

    mapping.originalPath = 

        absoluteNewPath; 

 

 

    mapping.updatedAt = 

        new Date() 

            .toISOString(); 

 

 

    registry.mappings[ 

        newId 

    ] = 

        mapping; 

 

 

    return newId; 

} 

 

 

/* 

