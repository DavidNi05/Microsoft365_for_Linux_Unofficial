         */ 

        if ( 

            baselineOriginalHash && 

            currentOriginalHash !== 

                baselineOriginalHash 

        ) { 

 

            const conflictPath = 

                buildConflictPath( 

                    mapping.originalPath 

                ); 

 

 

            fs.copyFileSync( 

                mapping.oneDrivePath, 

                conflictPath 

            ); 

 

 

            mapping.conflict = 

                true; 

 

 

            mapping.lastConflictAt = 

                new Date() 

                    .toISOString(); 

 

 

            mapping.lastConflictPath = 

                conflictPath; 

 

 

            mapping.lastError = 

                "Conflict detected: original file was modified locally. The Microsoft 365 version was preserved separately."; 

 

 

            mapping.lastCopiedHash = 

                currentOneDriveHash; 

 

 

            mapping.updatedAt = 

                new Date() 

                    .toISOString(); 

 

 

            writeRegistry( 

                registry 

            ); 

 

 

            pendingSaveBack.delete( 

                mappingIdValue 

            ); 

 

 

            console.warn( 

                "[External Sync] CONFLICT:", 

                mapping.originalPath 

            ); 

 

 

            console.warn( 

                "[External Sync] M365 version preserved as:", 

                conflictPath 

            ); 

 

 

            reportStatus( 

                "conflict", 

                { 

                    file: 

                        mapping.fileName, 

 

                    originalPath: 

                        mapping.originalPath, 

 

                    conflictPath 

                } 

            ); 

 

 

            return; 

        } 

 

 

        fs.accessSync( 

            mapping.originalPath, 

            fs.constants.W_OK 

        ); 

 

 

        reportStatus( 

            "saving", 

            { 

                file: 

                    mapping.fileName, 

 

                originalPath: 

                    mapping.originalPath 

            } 

        ); 

 

 

        console.log( 

            "[External Sync] Saving back:", 

            mapping.oneDrivePath, 

            "->", 

            mapping.originalPath 

        ); 

 

 

        fs.copyFileSync( 

            mapping.oneDrivePath, 

            mapping.originalPath 

        ); 

 

 

        try { 

 

            const sourceStat = 

                fs.statSync( 

                    mapping.oneDrivePath 

                ); 

 

 

            fs.utimesSync( 

                mapping.originalPath, 

                sourceStat.atime, 

                sourceStat.mtime 

            ); 

 

 

        } catch (_) {} 

 

 

        const newOriginalHash = 

            hashFile( 

                mapping.originalPath 

            ); 

 

 

        mapping.lastCopiedHash = 

            currentOneDriveHash; 

 

 

        mapping.originalBaselineHash = 

            newOriginalHash; 

 

 

        mapping.lastCopiedBackAt = 

            new Date() 

                .toISOString(); 

 

 

        mapping.updatedAt = 

            new Date() 

                .toISOString(); 

 

 

        mapping.conflict = 

            false; 

 

 

        mapping.lastConflictAt = 

            null; 

 

 

        mapping.lastConflictPath = 

            null; 

 

 

        mapping.lastError = 

            null; 

 

 

        writeRegistry( 

            registry 

        ); 

 

 

        pendingSaveBack.delete( 

            mappingIdValue 

        ); 

 

 

        console.log( 

            "[External Sync] Original file updated successfully:", 

            mapping.originalPath 

        ); 

 

 

        reportStatus( 

            "saved", 

            { 

                file: 

                    mapping.fileName, 

 

                originalPath: 

                    mapping.originalPath 

            } 

        ); 

 

 

    } catch ( 

        error 

    ) { 

 

        mapping.lastError = 

            error.message; 

 

 

        mapping.updatedAt = 

            new Date() 

                .toISOString(); 

 

 

        writeRegistry( 

            registry 

        ); 

 

 

        pendingSaveBack.delete( 

            mappingIdValue 

        ); 

 

 

        console.error( 

            "[External Sync] Save-Back failed:", 

            error 

        ); 

 

 

        reportStatus( 

            "error", 

            { 

                file: 

                    mapping.fileName, 

 

                error: 

                    error.message 

            } 

        ); 

    } 

} 

 

 

function scheduleStableSaveBack( 

    mapping, 

    expectedHash 

) { 

 

    const existing = 

        pendingSaveBack.get( 

            mapping.id 

        ); 

 

 

    if ( 

        existing 

    ) { 

 

        clearTimeout( 

            existing.timer 

        ); 

    } 

 

 

    reportStatus( 

        "syncing", 

        { 

            file: 

                mapping.fileName 

        } 

    ); 

 

 

    console.log( 

        "[External Sync] Waiting for file stability:", 

        mapping.oneDrivePath 

    ); 

 

 

    const timer = 

        setTimeout( 

            () => { 

 

                performStableSaveBack( 

                    mapping.id, 

                    expectedHash 

                ); 

 

            }, 

            STABILITY_DELAY_MS 

        ); 

 

 

    pendingSaveBack.set( 

        mapping.id, 

        { 

            timer, 

            expectedHash 

        } 

    ); 

} 

 

 

/* 

 * Called after OneDrive reports that a sync 

 * cycle has completed. 

 * 

 * We no longer copy immediately. 

 * We only schedule Save-Back. 

 */ 

function syncExternalCopiesBack() { 

 

    const registry = 

        readRegistry(); 

 

 

    let registryChanged = 

        cleanupStaleMappings( 

            registry 

        ); 

 

 

    for ( 

        const mapping 

        of Object.values( 

            registry.mappings 

        ) 

    ) { 

 

        try { 

 

            if ( 

                updateRenamedWorkingFile( 

                    mapping 

                ) 

            ) { 

 

                registryChanged = 

                    true; 

            } 

 

 

            if ( 

                !fs.existsSync( 

                    mapping.oneDrivePath 

                ) || 

                !fs.existsSync( 

                    mapping.originalPath 

                ) 

            ) { 

 

                continue; 

            } 

 

 

            const currentHash = 

                hashFile( 

                    mapping.oneDrivePath 

                ); 

 

 

            /* 

             * Nothing changed. 

             */ 

            if ( 

                currentHash === 

                mapping.lastCopiedHash 

            ) { 

 

                continue; 

            } 

 

 

            /* 

             * A changed OneDrive file is not copied 

             * immediately anymore. 

             */ 

            scheduleStableSaveBack( 

                mapping, 

                currentHash 

            ); 

 

 

        } catch ( 

            error 

        ) { 

 

            console.error( 

                "[External Sync] Unable to evaluate mapping:", 

                mapping.originalPath, 

                error.message 

            ); 

 

 

            reportStatus( 

                "error", 

                { 

                    file: 

                        mapping.fileName, 

 

                    error: 

                        error.message 

                } 

            ); 

        } 

    } 

 

 

    if ( 

        registryChanged 

    ) { 

 

        writeRegistry( 

            registry 

        ); 

    } 

} 

 

 

function getConflictMappings() { 

 

    const registry = 

        readRegistry(); 

 

 

    return Object 

        .values( 

            registry.mappings 

        ) 

        .filter( 

            mapping => 

                mapping.conflict 

        ); 

} 

 
 
