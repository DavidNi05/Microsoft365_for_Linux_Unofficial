                } 

            } 

 

 

            throw error; 

        } 

 

 

        /* 

         * Re-key the registry because originalPath changed. 

         */ 

        id = 

            rekeyMapping( 

                registry, 

                id, 

                mapping, 

                desiredPath 

            ); 

 

 

        mapping = 

            registry.mappings[ 

                id 

            ]; 

 

 

        const cloudHash = 

            hashFile( 

                mapping.oneDrivePath 

            ); 

 

 

        const localHash = 

            hashFile( 

                desiredPath 

            ); 

 

 

        mapping.lastCopiedHash = 

            cloudHash; 

 

 

        mapping.originalBaselineHash = 

            localHash; 

 

 

        mapping.lastCopiedBackAt = 

            new Date() 

                .toISOString(); 

 

 

        mapping.updatedAt = 

            new Date() 

                .toISOString(); 

 

 

        mapping.conflict = 

            false; 

 

 

        mapping.lastError = 

            null; 

 

 

        /* 

         * The managed OneDrive filename and local 

         * filename are now intentionally aligned. 

         */ 

        mapping.fileName = 

            cloudFileName; 

 

 

        registry.mappings[ 

            id 

        ] = 

            mapping; 

 

 

        writeRegistry( 

            registry 

        ); 

 

 

        console.log( 

            "[Manual Save Local] Renamed and saved:" 

        ); 

 

 

        console.log( 

            "  From:", 

            oldOriginalPath 

        ); 

 

 

        console.log( 

            "  To:", 

            desiredPath 

        ); 

 

 

        return { 

 

            ok: 

                true, 

 

            renamed: 

                true, 

 

            collision: 

                false, 

 

            fileName: 

                cloudFileName, 

 

            previousFileName: 

                originalFileName, 

 

            originalPath: 

                desiredPath, 

 

            savedPath: 

                desiredPath, 

 

            message: 

                `The file was renamed to ${cloudFileName} and saved to its original location.` 

        }; 

 

 

    } catch ( 

        error 

    ) { 

 

        console.error( 

            "[Manual Save Local] Failed:", 

            error 

        ); 

 

 

        return { 

 

            ok: 

                false, 

 

            renamed: 

                false, 

 

            collision: 

                false, 

 

            fileName: 

                mapping 

                    ? path.basename( 

                        mapping.oneDrivePath 

                    ) 

                    : path.basename( 

                        absoluteOriginal 

                    ), 

 

            originalPath: 

                mapping?.originalPath || 

                absoluteOriginal, 

 

            error: 

                error.message 

        }; 

    } 

} 

